# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=F1 Analytics Platform
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Set a strong password — must match in DATABASE_URL below
POSTGRES_DB=f1_analytics
POSTGRES_USER=f1user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://f1user:change_me@postgres:5432/f1_analytics

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── OpenF1 API (public, no key required) ─────────────────────────────────────
OPENF1_BASE_URL=https://api.openf1.org/v1

# ── Worker timing ─────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=1.5
WS_BROADCAST_INTERVAL=1.0
